# Optional: LLM-written random events. Without an API key the game is fully playable
# with the built-in offline events. Copy to .env and load it into your shell, e.g.
#   set -a; source .env; set +a; ./build/Beijing_Fushengji
# (the game does not read .env itself; real keys must never be committed).

# Any OpenAI-compatible server. Uncomment for a custom base URL or full .../chat/completions URL.
# Setting a URL explicitly enables requests even without a key (for keyless local servers).
# The default OpenAI URL is already used when an API key is provided.
#FUSHENGJI_AI_BASE_URL=https://api.openai.com/v1
FUSHENGJI_AI_MODEL=gpt-4o-mini
FUSHENGJI_AI_API_KEY=

# Request timeout in seconds (default 20).
#FUSHENGJI_AI_TIMEOUT=20

# Force the built-in offline events even when a key is set.
#FUSHENGJI_OFFLINE=1
